+bool isLibcFunction(std::string F) {
+    static const std::set<std::string> libcFunctions = {
+        "printf", "malloc", "free", "memcpy", "memset","fopen","srand","rand","time","strlen","mmset","fprintf","fgets","sizeof","sprintf","max","exit" // Add more libc functions as needed
+    };
+
+    return libcFunctions.find(F) != libcFunctions.end();
+}
+int nodeCount = 0 ; 
+class Node
+{
+   public : 
+   Node*next = nullptr ; 
+   int val ;
+   std::vector<llvm::StringRef> T ;
+   std::vector<Node*>neigh;   
+   Node*Last=nullptr; 
+   bool endBlock = false ;
+   bool ret = false ; 
+   bool visited = false ; 
+   Node() 
+   {
+    val = nodeCount++;
+   }
+};
+class gNode
+{
+  public :
+  llvm::StringRef t ;
+  int val ;  
+};
+vector<vector<gNode>>graph;
+void visit(Node*node,bool visited[])
+{
+     
+     visited[node->val] = true ;
+     for(int i = 0 ; i<node->neigh.size() ; i++)
+     {      
+       gNode x ; 
+       x.val = node->neigh[i]->val;
+       x.t   = node->T[i]        ; 
+       if(x.t.str() == "calculateSum" )
+       {
+        errs()<<visited[node->neigh[i]->val]<<":visted/notviisted";
+       }
+       graph[node->val].push_back(x);
+       if(!visited[node->neigh[i]->val])
+       visit(node->neigh[i],visited);   
+     }
+    
+}
